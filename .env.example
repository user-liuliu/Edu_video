# PostgreSQL（docker compose 使用）
POSTGRES_USER=eduvideo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eduvideo

# 后端连接串（密码需与 POSTGRES_PASSWORD 一致）
DATABASE_URL=postgresql+asyncpg://eduvideo:change-me@localhost:5432/eduvideo
TEST_DATABASE_URL=postgresql+asyncpg://eduvideo:change-me@localhost:5432/eduvideo_test
REDIS_URL=redis://localhost:6379/0

# 用于加密存储模型 API key 的 Fernet 密钥，生成命令：
# uv run python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
MASTER_KEY=
# 会话签名密钥，生成命令：
# python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
COOKIE_SECURE=false

# 初始管理员（bootstrap 命令使用）
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# 私有素材存储，仅容器内部访问；正式部署使用独立随机凭据
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=edu-materials
MINIO_SECURE=false
